#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC2154

START=99
USE_PROCD=1

script=$(readlink "$initscript")
NAME="$(basename ${script:-$initscript})"
CONFIG_NAME="krot"
PODKOP_BIN="/usr/bin/krot"
PODKOP_SERVICE_INIT="/etc/init.d/krot"
PODKOP_RELOAD_LOCK_DIR="/var/run/krot.reload.lock"
PODKOP_RUNTIME_STATE_DIR="/var/run/krot"
PODKOP_PENDING_RELOAD_FILE="$PODKOP_RUNTIME_STATE_DIR/reload.pending"
PODKOP_INTERNAL_CONFIG_TRIGGER_GUARD="/var/run/krot.internal-config-change"
PODKOP_CONFIG_CHANGE_REASON="on_config_change"
PODKOP_DNSMASQ_FAILSAFE="/usr/lib/krot/dnsmasq_failsafe_restore.sh"
config_load "$CONFIG_NAME"

restore_dnsmasq_failsafe() {
    if [ -r "$PODKOP_DNSMASQ_FAILSAFE" ]; then
        sh "$PODKOP_DNSMASQ_FAILSAFE" >/dev/null 2>&1 || true
        return 0
    fi

    uci -q delete dhcp.krot >/dev/null 2>&1 || true
    uci -q del_list 'dhcp.@dnsmasq[0].notinterface=br-lan' >/dev/null 2>&1 || true
    uci -q del_list 'dhcp.@dnsmasq[0].server=127.0.0.42' >/dev/null 2>&1 || true
    uci -q set 'dhcp.@dnsmasq[0].noresolv=0' >/dev/null 2>&1 || true
    uci -q set 'dhcp.@dnsmasq[0].cachesize=150' >/dev/null 2>&1 || true
    uci -q commit dhcp >/dev/null 2>&1 || true
    [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
}

acquire_reload_lock() {
    local owner_pid

    if mkdir "$PODKOP_RELOAD_LOCK_DIR" 2> /dev/null; then
        printf '%s\n' "$$" > "$PODKOP_RELOAD_LOCK_DIR/pid"
        return 0
    fi

    owner_pid="$(sed -n '1p' "$PODKOP_RELOAD_LOCK_DIR/pid" 2> /dev/null)"
    if [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2> /dev/null; then
        return 1
    fi

    # Stale lock: the owner process is gone. Deleting the whole directory and
    # recreating it opens a TOCTOU window, so recover in place instead:
    # 1) drop the stale pid file, 2) hard-link our own into the free slot.
    # ln(2) fails atomically when the slot was taken between (1) and (2), so
    # exactly one waiter wins; the losers back off. The final ownership check
    # makes sure the pid we release later is really ours.
    rm -f "$PODKOP_RELOAD_LOCK_DIR/pid" 2> /dev/null || true
    if printf '%s\n' "$$" > "$PODKOP_RELOAD_LOCK_DIR/pid.new.$$" 2>/dev/null; then
        if ln "$PODKOP_RELOAD_LOCK_DIR/pid.new.$$" "$PODKOP_RELOAD_LOCK_DIR/pid" 2>/dev/null &&
            [ "$(cat "$PODKOP_RELOAD_LOCK_DIR/pid" 2>/dev/null)" = "$$" ]; then
            rm -f "$PODKOP_RELOAD_LOCK_DIR/pid.new.$$" 2>/dev/null || true
            return 0
        fi
        rm -f "$PODKOP_RELOAD_LOCK_DIR/pid.new.$$" 2>/dev/null || true
        return 1
    fi

    # Another waiter died between its mkdir and its ln into the pid slot,
    # leaving a corpse subdirectory that would otherwise block every future
    # waiter until reboot. Clean up corpses whose owner is gone.
    for pending_dir in "$PODKOP_RELOAD_LOCK_DIR"/pid.*; do
        [ -d "$pending_dir" ] || continue
        pending_owner="$(cat "$pending_dir/pid" 2>/dev/null)"
        [ -n "$pending_owner" ] && kill -0 "$pending_owner" 2>/dev/null && continue
        rm -rf "$pending_dir" 2>/dev/null || true
    done

    # Someone else is trying to acquire the lock right now; let it finish.
    return 1
}

release_reload_lock() {
    rm -f "$PODKOP_RELOAD_LOCK_DIR/pid" 2> /dev/null
    rmdir "$PODKOP_RELOAD_LOCK_DIR" 2> /dev/null
}

mark_pending_reload() {
    local reason="${1:-pending}"
    local now

    mkdir -p "$PODKOP_RUNTIME_STATE_DIR"
    now="$(date +%s 2>/dev/null)"
    case "$now" in
        '' | *[!0-9]*)
            now=0
            ;;
    esac

    # Write atomically via temp file to avoid partial reads
    local tmp_file
    tmp_file="$(mktemp "$PODKOP_PENDING_RELOAD_FILE.XXXXXX" 2>/dev/null)" || return 1
    {
        printf 'reason=%s\n' "$reason"
        printf 'updated_at=%s\n' "$now"
    } > "$tmp_file"
    mv "$tmp_file" "$PODKOP_PENDING_RELOAD_FILE" 2>/dev/null || rm -f "$tmp_file"
}

consume_pending_reload() {
    [ -f "$PODKOP_PENDING_RELOAD_FILE" ] || return 1
    rm -f "$PODKOP_PENDING_RELOAD_FILE" 2>/dev/null
}

run_pending_reload_if_requested() {
    consume_pending_reload || return 0
    "$PODKOP_SERVICE_INIT" reload pending >/dev/null 2>&1 &
}

sync_service_triggers() {
    config_load "$CONFIG_NAME"
    _procd_call sync_service_triggers_payload
}

sync_service_triggers_payload() {
    # rc.common registers triggers when the service is started. Config reloads can
    # change Bad WAN interface triggers, so refresh the trigger set after a
    # successful config-change reload without restarting the runtime.
    json_init
    json_add_string name "$NAME"
    service_triggers
    _procd_ubus_call set > /dev/null 2>&1 || true
}

is_config_change_reload() {
    [ "$1" = "$PODKOP_CONFIG_CHANGE_REASON" ]
}

runtime_is_running() {
    "$PODKOP_BIN" get_status 2> /dev/null | grep -q '"running"[[:space:]]*:[[:space:]]*1'
}

service_is_enabled() {
    [ -x "/etc/rc.d/S99$NAME" ]
}

consume_internal_config_guard() {
    rm -f "$PODKOP_INTERNAL_CONFIG_TRIGGER_GUARD" 2> /dev/null
}

internal_config_guard_is_recent() {
    local now guard_timestamp

    guard_timestamp="$(sed -n '1p' "$PODKOP_INTERNAL_CONFIG_TRIGGER_GUARD" 2>/dev/null)"
    case "$guard_timestamp" in
        '' | *[!0-9]*)
            return 1
            ;;
    esac

    now="$(date +%s 2>/dev/null)"
    case "$now" in
        '' | *[!0-9]*)
            return 0
            ;;
    esac

    [ $((now - guard_timestamp)) -le 30 ]
}

should_skip_internal_config_reload() {
    local reason="$1"

    [ "$reason" = "on_config_change" ] || return 1
    [ -f "$PODKOP_INTERNAL_CONFIG_TRIGGER_GUARD" ] || return 1

    if internal_config_guard_is_recent; then
        consume_internal_config_guard
        return 0
    fi

    consume_internal_config_guard

    return 1
}

start_service() {
    echo "Start K.R.O.T."

    if [ ! -x "$PODKOP_BIN" ]; then
        restore_dnsmasq_failsafe
        return 1
    fi

    config_get enable_badwan_interface_monitoring "settings" "enable_badwan_interface_monitoring"
    config_get badwan_monitored_interfaces "settings" "badwan_monitored_interfaces"

    procd_open_instance
    procd_set_param command "$PODKOP_BIN" start
    if [ "$enable_badwan_interface_monitoring" = "1" ] && [ -n "$badwan_monitored_interfaces" ]; then
        for iface in $badwan_monitored_interfaces; do
            procd_set_param netdev "$iface"
        done
    fi
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    local status

    if [ ! -x "$PODKOP_BIN" ]; then
        restore_dnsmasq_failsafe
        return 1
    fi

    "$PODKOP_BIN" stop
    status="$?"
    [ "$status" -eq 0 ] || restore_dnsmasq_failsafe

    return "$status"
}

reload_service() {
    local reason="$1"
    local status

    if should_skip_internal_config_reload "$reason"; then
        return 0
    fi

    if is_config_change_reload "$reason" && ! runtime_is_running && ! service_is_enabled; then
        return 0
    fi

    if ! acquire_reload_lock; then
        mark_pending_reload "${reason:-reload_busy}"
        return 0
    fi

    # Run the reload in a subshell that owns the lock via its EXIT trap; the
    # exit status propagates directly to this shell. No shared status file:
    # writing one inside the lock directory left the directory un-rmdir-able at
    # trap time, and the follow-up unconditional release could then steal the
    # lock (and the status) from the next waiter.
    status=0
    (
        trap 'release_reload_lock' EXIT INT TERM
        "$PODKOP_BIN" reload "$reason" > /dev/null 2>&1
    ) || status=$?

    if [ "$status" -eq 0 ] && is_config_change_reload "$reason"; then
        sync_service_triggers
    fi
    run_pending_reload_if_requested

    return "$status"
}

status_service() {
    if runtime_is_running; then
        echo "running"
        return 0
    fi

    echo "not running"
    return 1
}

service_triggers() {
    config_get enable_badwan_interface_monitoring "settings" "enable_badwan_interface_monitoring"
    config_get badwan_monitored_interfaces "settings" "badwan_monitored_interfaces"
    config_get badwan_reload_delay "settings" "badwan_reload_delay" "2000"

    PROCD_RELOAD_DELAY=$badwan_reload_delay

    procd_open_trigger
    procd_add_config_trigger "config.change" "$CONFIG_NAME" "$PODKOP_SERVICE_INIT" reload "$PODKOP_CONFIG_CHANGE_REASON"

    if [ "$enable_badwan_interface_monitoring" = "1" ]; then
        for iface in $badwan_monitored_interfaces; do
            procd_add_interface_trigger "interface.*.up" "$iface" "$PODKOP_SERVICE_INIT" reload
        done
    fi
    procd_close_trigger
}
