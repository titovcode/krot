#!/bin/sh /etc/rc.common
# Copyright (C) 2026 K.R.O.T. Team

START=95
STOP=10
USE_PROCD=1

NAME="xray"
PROG="/usr/bin/xray"
CONFIG_DIR="/etc/xray"
DEFAULT_CONFIG="/etc/xray/config.json"

start_service() {
    config_load xray
    local enabled
    local config_file
    config_get_bool enabled settings enabled 1
    config_get config_file settings config_file "$DEFAULT_CONFIG"

    [ "$enabled" -eq 1 ] || return 0

    if [ ! -x "$PROG" ]; then
        if [ -x "/opt/xray/xray" ]; then
            PROG="/opt/xray/xray"
        else
            logger -t xray "Binary not found"
            return 1
        fi
    fi

    if [ ! -f "$config_file" ]; then
        logger -t xray "Config file $config_file not found"
        return 1
    fi

    # Per-rule Xray fragments are rendered by K.R.O.T. into /etc/xray/conf.d.
    # Xray-core ignores a "confdir" key inside the JSON config (verified
    # against 26.3.27: `run -dump` with and without the key merges the exact
    # same set of inbounds); the only way to load them is the "-confdir"
    # command line flag, so it has to be part of the service command.
    #
    # A directory holding a broken fragment must not take the base exit down
    # (other rules depend on it): validate with the fragments first and fall
    # back to the base config alone when that fails. A missing directory is
    # created here so manually placed drop-ins always have a home.
    mkdir -p /etc/xray/conf.d 2> /dev/null || true
    local use_confdir=0
    if "$PROG" run -test -c "$config_file" -confdir /etc/xray/conf.d > /dev/null 2>&1; then
        use_confdir=1
    else
        logger -t xray "Per-rule configs in /etc/xray/conf.d are invalid; starting with the base config only"
    fi

    # Verify config before starting
    if ! "$PROG" run -test -c "$config_file" > /dev/null 2>&1; then
        logger -t xray "Config validation failed for $config_file"
        return 1
    fi

    procd_open_instance
    if [ "$use_confdir" -eq 1 ]; then
        procd_set_param command "$PROG" run -c "$config_file" -confdir /etc/xray/conf.d
    else
        procd_set_param command "$PROG" run -c "$config_file"
    fi
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

stop_service() {
    procd_kill "$NAME" 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "xray"
}
