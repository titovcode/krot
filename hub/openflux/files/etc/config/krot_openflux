# K.R.O.T. OpenFlux Exit Node module configuration.
# Manage from LuCI: Services -> OpenFlux.

config settings 'settings'
	# Base URL serving openflux-linux-<arch> binaries.
	# Empty = try upstream p1neappleXpress/OpenFlux releases (no Linux assets yet).
	# Build binaries with hub/openflux/build-binaries.sh and host them yourself.
	#option bin_base ''

	# Force iptables RST suppression instead of nftables (rare firmware without nft).
	#option use_iptables '0'

	# Suppress kernel TCP RST for l3 mode (see OpenFlux issue #44). Disable only
	# if you set up the rule yourself.
	#option suppress_rst '1'

# One instance = one running openflux exit node. Add another instance for
# another transport/URL pair. Clients (OpenFluxAndroid) choose a server by
# transport + url combination, so different instances serve different phones.
#
#config instance 'phone1'
#	option enabled '1'
#	option label 'My phone'
#	option transport 'yandex'           # yandex | vyandex | oneme | cupsonline | mailru
#	option exit_mode 'l3'               # l3 (raw SNAT/DNAT, root) | l4 (gVisor, no root)
#	option url ''                       # yandex/vyandex/mailru: doc URL; oneme: not used
#	option max_token ''                 # oneme: MAX authorization token
#	option max_uid ''                   # oneme: MAX user id
#	option listen_port '4545'           # l4 mode SOCKS fallback listener (localhost only)
#	option codec 'batched'              # batched | legacy (must match the client)
#	option encryption_key ''            # optional shared secret file content (AES-256-GCM)
#	option local_ip ''                  # egress IP for l3 SNAT/RST filter (empty = auto)
#	option debug '0'
