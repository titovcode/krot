{
  "luci-app-krot-wlb": {
    "description": "Grant UCI and RPC access to the K.R.O.T. Whitelist Bypass module",
    "read": {
      "file": {
        "/etc/init.d/krot-wlb": [ "exec", "read" ],
        "/usr/lib/krot-wlb/wlb-notify.sh": [ "exec" ],
        "/usr/lib/krot-wlb/wlb-yandex-login.sh": [ "exec" ],
        "/bin/chmod": [ "exec" ],
        "/etc/krot-wlb/*": [ "read" ],
        "/var/run/krot-wlb/*": [ "read" ],
        "/tmp/run/krot-wlb/*": [ "read" ],
        "/tmp/run/krot-wlb/*": [ "read" ]
      },
      "ubus": {
        "service": [ "list" ]
      },
      "uci": [ "krot_wlb" ]
    },
    "write": {
      "file": {
        "/etc/init.d/krot-wlb": [ "exec" ],
        "/etc/krot-wlb/*": [ "write" ]
      },
      "uci": [ "krot_wlb" ]
    }
  }
}
