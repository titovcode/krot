# K.R.O.T. Whitelist Bypass module configuration.
# Manage instances from LuCI: Services -> WLB: Mobile bypass.

config settings 'settings'
	# Base URL with headless-<platform>-creator-linux-<arch> binaries.
	# Empty = use upstream kulikov0/whitelist-bypass releases.
	#option bin_base ''

